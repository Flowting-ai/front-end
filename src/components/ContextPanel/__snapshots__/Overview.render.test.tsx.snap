exports[`OverviewView DOM > working with a to-do list, ticking 1`] = `"<div style="display: flex; flex-direction: column; border-radius: 16px; background-color: var(--card-bg); box-shadow: inset 0 0 0 1px var(--neutral-200); overflow: hidden;"><section><div style="position: relative; display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0px 10px 0px 14px;"><button type="button" aria-expanded="true" aria-controls="_r_8_" class="bg-transparent hover:bg-[color-mix(in_srgb,var(--neutral-200)_50%,transparent)] focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--blue-500)]" style="position: absolute; inset: 0px; border: 0px; padding: 0px; margin: 0px; cursor: pointer; transition: background-color 150ms ease;"><span style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0px);">To-dos</span></button><h3 aria-hidden="true" style="margin: 0px; font-family: var(--font-body); font-size: var(--font-size-body); line-height: var(--line-height-body); color: var(--neutral-600); pointer-events: none; position: relative;">To-dos</h3><div></div><span style="margin: 0px; font-family: var(--font-body); font-size: var(--font-size-caption); line-height: var(--line-height-caption); color: var(--neutral-500); position: relative; pointer-events: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;"><span role="status" style="display: inline-flex; align-items: center; gap: 5px; height: 22px; padding: 0px 8px 0px 7px; border-radius: 999px; background-color: color-mix(in srgb, var(--blue-500) 14%, transparent); color: var(--neutral-700); font-weight: var(--font-weight-medium);"><svg width="11" height="11" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="color: var(--blue-500); flex-shrink: 0;"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.25"></circle><path d="M 10 3 A 7 7 0 0 1 17 10" stroke="currentColor" stroke-width