tyle="overflow: hidden; height: auto; opacity: 1;"><div style="display: flex; flex-direction: column; gap: 2px; padding: 0px 8px 10px;"><ol aria-label="To-dos" style="list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 2px; opacity: 0; transform: translateY(4px);"><li style="opacity: 1; transition: opacity 320ms ease;"><div style="display: flex; align-items: flex-start; gap: 10px; width: 100%; min-width: 0px; padding: 6px; border-radius: 8px; border: 0px; text-align: left; text-decoration: none; color: inherit; transition: background-color 150ms ease;"><span aria-hidden="true" style="min-width: 20px; min-height: 20px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: var(--neutral-500);"><span style="display: inline-flex; opacity: 1; transform: none;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 14L8.5 17.5L19 6.5" stroke="var(--green-500)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></span><span style="min-width: 0px; display: flex; flex-direction: column;"><span style="margin: 0px; font-family: var(--font-body); font-size: var(--font-size-body); line-height: var(--line-height-body); color: var(--neutral-500); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-decoration: line-through;">Search</span></span></div></li><li aria-current="step" style="opacity: 1; transition: opacity 320ms ease;"><div style="display: flex; align-items: flex-start; gap: 10px; width: 100%; min-width: 0px; padding: 6px; border-radius: 8px; border: 0px; text-align: left; text-decoration: none; color: inherit; transition: background-color 150ms ease;"><span aria-hidden="true" style="min-width: 20px; min-height: 20px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: var(--neutral-500);"><svg width="14" height="14" viewBox="0 0