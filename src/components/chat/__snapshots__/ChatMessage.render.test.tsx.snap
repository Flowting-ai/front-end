ody)] leading-[var(--line-height-body)] transition-[background-color,border-color,box-shadow,filter,translate,scale,opacity] duration-200 cursor-pointer outline-none focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-[var(--focus-ring)] active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-70 disabled:hover:[background-image:none] disabled:data-[active=true]:[background-image:none] disabled:hover:[filter:none] disabled:active:scale-100 disabled:hover:scale-100 aria-busy:cursor-progress [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 p-0 bg-transparent text-[var(--icon-button-ghost-2-icon)] disabled:text-[var(--icon-button-ghost-2-icon-disabled)] hover:[background-image:linear-gradient(var(--hv),var(--hv))] data-[active=true]:[background-image:linear-gradient(var(--hv),var(--hv))] [--hv:var(--icon-button-ghost-2-bg-hover)] size-6 rounded-[6px]" aria-label="Regenerate"><span class="flex items-center justify-center [&amp;_svg]:size-full" style="width: 14px; height: 14px;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C15.2073 3 18.0227 4.67765 19.6166 7.20327M20.7066 3.00076L20.5344 5.05452C20.4104 6.53384 20.3484 7.27349 19.8664 7.68914C19.3844 8.10479 18.6733 8.03185 17.251 7.88595L15.2066 7.67625" stroke="var(--neutral-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></button></div></div></div>"`;

exports[`ChatMessage markup > user with attachments 1`] = `"<div data-message-id="m1" role="article" aria-label="Your message" style="display: flex; flex-direction: column; align-items: flex-end; padding: 12px 0px; width: 100%; opacity: 1; transform: none;"><div style="display: flex; flex-direction: column; align-items: flex-end; gap: 6px; width: 100%; max-width: 566px;"><div style="display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end;"><div style="position: relative; display: inline-flex; align-items: center; gap: 10px; padding: 6px 12px 6px 6px; border-radius: 14px; background-color: color-mix(in srgb, var(--neutral-800) 7%, transparent); border: 1px solid var(--neutral-800-10); max-width: 260px;"><button type="button" aria-label="Expand pic.png" class="focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--focus-ring)]" style="position: relative; width: 56px; height: 56px; padding: 0px; border: medium; background: none; border-radius: 10px; overflow: hidden; flex-shrink: 0; cursor: zoom-in;"><img alt="" sizes="56px" style="object-fit: cover;" src="https://x/pic.png"></button><span style="display: flex; flex-direction: column; gap: 2px; min-width: 0px;"><span style="font-family: var(--font-body); font-size: 12px; font-weight: 500; color: var(--neutral-700); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">pic.png</span><span style="font-family: var(--font-body); font-size: 12px; color: var(--neutral-600); flex-shrink: 0;">PNG</span></span></div><div style="display: inline-flex; align-items: center; gap: 5px; padding: 4px 8px; border-radius: 8px; background-color: color-mix(in srgb, var(--neutral-800) 7%, transparent); border: 1px solid var(--neutral-800-10); max-width: 220px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--neutral-500)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 