exports[`ChatMessage markup > assistant stopped with error notice 1`] = `"<div data-message-id="m1" role="article" aria-label="Assistant response" style="display: flex; flex-direction: column; align-items: flex-start; padding: 12px 0px; width: 100%; opacity: 1; transform: none;"><div style="width: 100%; min-width: 0px;"><div style="opacity: 1; transform: none;"><div data-testid="text">Half</div></div><span style="display: inline-block; margin-top: 8px; font-family: var(--font-body); font-size: 12px; color: var(--neutral-500); font-style: italic;">Generation stopped</span><div role="alert" style="display: flex; align-items: center; gap: 12px; margin-top: 12px; padding: 10px 12px 10px 14px; border-radius: 12px; background: color-mix(in srgb, var(--red-500) 4%, transparent); border: 1px solid color-mix(in srgb, var(--red-500) 18%, transparent); opacity: 0; transform: translateY(6px);"><span style="flex: 1 1 0%; min-width: 0px; font-family: var(--font-body); font-size: 14px; line-height: 22px; color: var(--neutral-700);">Rate limit exceeded</span><button type="button" style="flex-shrink: 0; background: transparent; border: 1px solid color-mix(in srgb, var(--red-500) 28%, transparent); border-radius: 8px; padding: 6px 12px; font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--red-600); cursor: pointer;">Retry</button></div><div style="display: flex; gap: 2px; margin-top: 4px; pointer-events: auto;"><button data-slot="icon-button" type="button" class="group/button relative inline-flex shrink-0 items-center justify-center whitespace-nowrap select-none border border-transparent [font-family:var(--font-title)] font-[var(--font-weight-medium)] text-[length:var(--font-size-body)] leading-[var(--line-height-body)] transition-[background-color,border-color,box-shadow,filter,translate,scale,opacity] duration-200 cursor-pointer outline-none focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-[var(--focus-ring)] active:scale-[0